rules_version = '2';
// Paste into Firebase console > Firestore Database > Rules > Publish.
// The website can only ADD investor records. Nobody can read, edit or delete them from the
// website; view them in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {
    match /investors/{id} {
      allow create: if request.resource.data.keys().hasOnly(
          ['name', 'designation', 'company', 'phone', 'email', 'website', 'address', 'notes', 'rawText', 'source', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string && request.resource.data.name.size() < 200
        && request.resource.data.notes is string && request.resource.data.notes.size() < 2000
        && request.resource.data.address is string && request.resource.data.address.size() < 1000
        && request.resource.data.rawText is string && request.resource.data.rawText.size() < 5000;
      allow read, update, delete: if false;
    }
  }
}
